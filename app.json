{
  "expo": {
    "name": "mediport",
    "slug": "mediport-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mediport.png",
    "scheme": "mediportfront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FFFCF9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mediport.png",
        "backgroundColor": "#FFFCF9"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/mediport.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mediport.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#50ACC5"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
